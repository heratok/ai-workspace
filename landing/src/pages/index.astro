---
import Base from '../layouts/Base.astro';
import Diagrama from '../components/Diagrama.astro';

const terminal = [
  { c: 'prompt', t: './setup.sh install' },
  { c: 'info', t: '==> Clave autorizada: 256 SHA256:… (ED25519)' },
  { c: 'ok', t: 'Listo. Accesible SOLO desde tu tailnet.' },
  { c: 'dim', t: '  SSH   : ssh ai@ai-workspace' },
  { c: 'dim', t: '  Mosh  : mosh -p 60000:60010 ai@ai-workspace' },
  { c: 'dim', t: '  Web   : http://ai-workspace:3000  |  :5173' },
  { c: 'dim', t: '  BD local : devdb start (PostgreSQL) | devdb start redis' },
];

const instalar = [
  ['Valida requisitos', 'Docker + plugin compose v2 y /dev/net/tun. En el servidor no se instala nada más.'],
  ['Normaliza y configura', 'Corrige CRLF, crea .env (600) desde env.example y genera secretos.'],
  ['Pregunta lo interactivo', 'Auth key de Tailscale (o link de login) y tu clave SSH. Después no pregunta nada.'],
  ['Sigue en segundo plano', 'setsid + nohup: si se cae SSH la instalación continúa. ./setup.sh progress la retoma.'],
  ['Migraciones y volúmenes', 'Aplica migrations/NNN-*.sh pendientes y crea ai_home y ai_workspace.'],
  ['Build y arranque', 'Construye la imagen; el workspace espera a que el sidecar esté healthy.'],
  ['Limpia y autoriza', 'Borra la auth key del .env tras registrar el nodo y autoriza tu clave SSH.'],
  ['Diagnóstico', 'ws-doctor revisa herramientas, rutas y permisos e imprime cómo conectarte.'],
];

const arranque = [
  ['Clave de host SSH', 'ed25519 persistente en ai_ssh_host_keys: nada de "host key changed" al reconstruir.'],
  ['Home y workspace', 'Corrige el dueño de los volúmenes (FIX_OWNERSHIP=true hace chown recursivo una vez).'],
  ['Dotfiles', 'Siembra /etc/skel-ai sin sobrescribir lo que el usuario ya tiene.'],
  ['Rutas sin root', '~/.local/bin, ~/.npm-global, ~/.cache… con dueño ai para instalar sin privilegios.'],
  ['runtime.env', 'SQLCMD* y DOPPLER_TOKEN llegan a SSH vía /etc/ai-workspace/runtime.env (640 root:ai).'],
  ['devdb autostart', 'Arranca como ai las bases marcadas con devdb enable.'],
  ['sshd', 'Valida la configuración (sshd -t) y queda en primer plano como proceso principal.'],
];

const capasImagen = [
  { t: 'Tu home · ai_home', d: 'npm i -g, uv tool, mise use, devdb install. Sin root y sin reconstruir.', k: 'usuario' },
  { t: 'Extensiones del equipo', d: 'config/extra-root.sh y NPM_EXTRA_PACKAGES para lo que todos necesitan.', k: 'imagen' },
  { t: 'Agentes de IA', d: 'Claude Code, Pi, Antigravity, Gentle AI, opencode, Herdr y Playwright + Chromium, cada uno con su INSTALL_*.', k: 'imagen' },
  { t: 'Datos', d: 'Clientes psql 17, sqlite3, redis-cli y mariadb. Servidores bajo demanda con devdb.', k: 'imagen' },
  { t: 'Lenguajes', d: 'Node 24 con pnpm/yarn, Python 3 con uv y mise para Go, Rust o Java.', k: 'imagen' },
  { t: 'Base', d: 'debian:12-slim, config/packages.apt, locale en_US.UTF-8 y zona America/Bogota.', k: 'imagen' },
];

const seguridad = [
  { t: 'NET_ADMIN solo en el sidecar', d: 'El workspace no recibe capabilities ni /dev/net/tun.', i: 'red' },
  { t: 'Usuario ai sin root', d: 'Sin sudo ni docker.sock. Root solo prepara sshd en el arranque.', i: 'user' },
  { t: 'no-new-privileges', d: 'Ningún binario setuid puede escalar privilegios.', i: 'lock' },
  { t: 'SSH endurecido', d: 'Solo clave pública, AllowUsers ai, MaxAuthTries 3, LoginGraceTime 30.', i: 'key' },
  { t: 'Límites de recursos', d: '8 GB de RAM, 4 CPU y 2048 procesos: un proceso desbocado no tumba el servidor.', i: 'cpu' },
  { t: 'Secretos fuera de la imagen', d: '.env 600 fuera de git, auth key borrada tras el registro, Doppler para proyectos.', i: 'vault' },
  { t: 'Bases en 127.0.0.1', d: 'PostgreSQL y Redis de devdb solo en loopback; desde tu PC, túnel SSH.', i: 'db' },
];

const iconos: Record<string, string> = {
  red: '<path d="M12 3v6M12 15v6M3 12h6M15 12h6"/><circle cx="12" cy="12" r="3"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3"/>',
  cpu: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
  vault: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M12 9V7"/>',
  db: '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
};

const volumenes = [
  { v: 'ai_home', c: 'Configuración, instalaciones sin root y datos de devdb', r: 'Pierdes tu configuración y bases locales', n: 2 },
  { v: 'ai_workspace', c: 'Tus proyectos en /workspace', r: 'Pierdes tus proyectos', n: 3 },
  { v: 'ai_ssh_host_keys', c: 'Identidad SSH del servidor', r: 'Alerta "host key changed"', n: 1 },
  { v: 'ai_ts_state', c: 'Identidad del nodo en Tailscale', r: 'Nodo nuevo; vuelve a pedir la auth key', n: 1 },
  { v: 'ai_mssql_data', c: 'Datos de SQL Server (si se usa)', r: 'Pierdes esas bases', n: 3 },
];

const pipeline = [
  { e: 'GitHub', t: 'push a main', d: 'CI: sintaxis, ShellCheck, compose válido, build completo y verificación de cada herramienta.' },
  { e: 'servidor', t: 'upgrade', d: 'fetch + merge --ff-only. Stash de cambios locales, anota la versión previa y agrega variables nuevas al .env.' },
  { e: 'servidor', t: 'migrate + update', d: 'Cada migración corre una sola vez. Si el build falla, el contenedor anterior sigue en pie.' },
  { e: 'plan B', t: 'rollback', d: 'Vuelve a la versión anotada y reconstruye. clean borra solo las imágenes del proyecto.' },
];

const comandos = [
  ['install', 'Instala o reinstala; conserva datos'],
  ['upgrade', 'Lo último de GitHub, migra y reconstruye'],
  ['rollback', 'Vuelve a la versión anterior'],
  ['components', 'Elige agentes y herramientas'],
  ['progress', 'Sigue la instalación en vivo'],
  ['backup', 'Respalda home y proyectos'],
  ['clean --deep', 'Imágenes, logs y respaldos viejos'],
  ['doctor', 'Diagnóstico de herramientas y permisos'],
];
---
<Base title="Arquitectura ai-workspace">
  <div class="fondo" aria-hidden="true"><div class="rejilla"></div><div class="orbe o1"></div><div class="orbe o2"></div></div>

  <main id="top">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-txt">
        <a class="pill rv" href="#diagrama"><span class="live"></span>ai-workspace v2 · arquitectura</a>
        <h1 class="rv">Una sola puerta.<br /><span class="grad">Cero puertos abiertos.</span></h1>
        <p class="lead rv">Un entorno de desarrollo en Docker al que solo se llega por <strong>Tailscale</strong>. El sidecar es la única entrada,
          el usuario <code>ai</code> no tiene root y todo lo importante vive en volúmenes que sobreviven a cada reconstrucción.</p>
        <div class="cta rv">
          <a class="btn primario" href="#diagrama">Explorar el diagrama
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg></a>
          <a class="btn" href="#operacion">Cómo se actualiza</a>
        </div>
      </div>

      <div class="term entra" role="img" aria-label="Salida de ./setup.sh install">
        <div class="term-bar"><i></i><i></i><i></i><span class="mono">ai@servidor — setup.sh</span></div>
        <pre class="mono">{terminal.map((l, i) => <span class={`ln ${l.c}`} style={`--i:${i}`}>{l.c === 'prompt' ? <><b>$</b> {l.t}</> : l.t}{'\n'}</span>)}<span class="cursor" style={`--i:${terminal.length}`}>▋</span></pre>
      </div>
    </section>

    <section class="wrap stats rv">
      <div><strong class="display">0</strong><span>puertos publicados en el servidor</span></div>
      <div><strong class="display">1</strong><span>script para instalar, actualizar y operar</span></div>
      <div><strong class="display">5</strong><span>volúmenes que persisten</span></div>
      <div><strong class="display">0</strong><span>privilegios de root para el usuario</span></div>
    </section>

    <!-- DIAGRAMA -->
    <section id="diagrama" class="wrap bloque">
      <header class="cab rv"><span class="num mono">01</span><h2>Cómo encaja todo</h2>
        <p>Dos contenedores comparten una sola pila de red. El workspace no tiene red propia: hereda la del sidecar de Tailscale.</p></header>
      <Diagrama />
    </section>

    <!-- CICLO DE VIDA -->
    <section id="ciclo" class="wrap bloque">
      <header class="cab rv"><span class="num mono">02</span><h2>Ciclo de vida</h2>
        <p>Todo se opera con <code>setup.sh</code>. Primero instala desde el servidor y luego el contenedor se prepara solo en cada arranque.</p></header>
      <div class="tabs rv" role="tablist">
        <button role="tab" aria-selected="true" data-tab="instalar"><code>./setup.sh install</code><span>8 pasos</span></button>
        <button role="tab" aria-selected="false" data-tab="arranque"><code>entrypoint.sh</code><span>7 pasos</span></button>
      </div>
      <ol class="pasos" data-panel="instalar">
        {instalar.map(([t, d], i) => (<li class="rv" style={`--d:${i * 50}ms`}><span class="n display">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>))}
      </ol>
      <ol class="pasos" data-panel="arranque" hidden>
        {arranque.map(([t, d], i) => (<li><span class="n display">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>))}
      </ol>
    </section>

    <!-- IMAGEN -->
    <section id="imagen" class="wrap bloque">
      <header class="cab rv"><span class="num mono">03</span><h2>La imagen, capa por capa</h2>
        <p>Lo del sistema va en la imagen. Lo del usuario va sin root en su home y no requiere reconstruir.</p></header>
      <div class="pila">
        {capasImagen.map((c, i) => (
          <div class={`capa rv ${c.k}`} style={`--i:${i}`}>
            <span class="k mono">{c.k === 'usuario' ? 'volumen · sin root' : `capa ${capasImagen.length - i - 1}`}</span>
            <h3>{c.t}</h3><p>{c.d}</p>
          </div>
        ))}
      </div>
      <p class="nota rv">Cada agente es un <code>ARG INSTALL_*=true|false</code>. Con <code>./setup.sh components</code> eliges cuáles entran; lo que desmarcas sale de la imagen sin tocar tus datos.</p>
    </section>

    <!-- SEGURIDAD -->
    <section id="seguridad" class="wrap bloque">
      <header class="cab rv"><span class="num mono">04</span><h2>Seguridad por capas</h2>
        <p>Pensado para datos sensibles: cada capa reduce lo que un atacante, o un error, puede alcanzar.</p></header>
      <div class="bento">
        <article class="card grande rv">
          <div class="radar" aria-hidden="true"><span></span><span></span><span></span><b></b></div>
          <h3>Sin puertos publicados</h3>
          <p>El compose no tiene <code>ports:</code>. Todo entra por la IP 100.x de Tailscale sobre WireGuard; desde Internet no hay nada que escanear.</p>
        </article>
        {seguridad.map((s, i) => (
          <article class="card rv" style={`--d:${i * 40}ms`}>
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconos[s.i]} />
            <h3>{s.t}</h3><p>{s.d}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PERSISTENCIA -->
    <section class="wrap bloque">
      <header class="cab rv"><span class="num mono">05</span><h2>Lo que persiste</h2>
        <p><code>uninstall</code> conserva todo. Solo <code>uninstall --all</code> borra, después de ofrecer respaldo y pedir que escribas <code>BORRAR</code>.</p></header>
      <div class="vols">
        {volumenes.map(v => (
          <article class="vol rv">
            <div class="vol-top"><span class="mono">{v.v}</span>
              <span class="riesgo" title={`Impacto si se borra: ${['', 'bajo', 'medio', 'alto'][v.n]}`}>{[1, 2, 3].map(x => <i class={x <= v.n ? `on n${v.n}` : ''}></i>)}</span></div>
            <p>{v.c}</p>
            <p class="si"><span>Si lo borras:</span> {v.r}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- OPERACIÓN -->
    <section id="operacion" class="wrap bloque">
      <header class="cab rv"><span class="num mono">06</span><h2>Actualizaciones sin miedo</h2>
        <p>Cada cambio se verifica antes de llegar al servidor, y siempre hay un camino de vuelta.</p></header>
      <ol class="pipe">
        {pipeline.map((p, i) => (
          <li class="rv" style={`--d:${i * 90}ms`}><span class="punto"></span><span class="e mono">{p.e}</span><h3>{p.t}</h3><p>{p.d}</p></li>
        ))}
      </ol>
    </section>

    <!-- COMANDOS -->
    <section class="wrap bloque">
      <header class="cab rv"><span class="num mono">07</span><h2>A mano</h2>
        <p>Los comandos que más vas a usar. Haz clic para copiar.</p></header>
      <div class="cmds">
        {comandos.map(([c, d]) => (
          <button class="cmd rv" data-copiar={`./setup.sh ${c}`}><code>./setup.sh {c}</code><span>{d}</span><em class="mono">copiar</em></button>
        ))}
      </div>
      <div class="term mini rv">
        <div class="term-bar"><i></i><i></i><i></i><span class="mono">tu-pc — conectado a la tailnet</span></div>
        <pre class="mono"><span class="dim"># entrar</span>
<b>$</b> ssh ai@ai-workspace
<b>$</b> mosh -p 60000:60010 ai@ai-workspace
<span class="dim"># DBeaver o Power BI contra el Postgres local</span>
<b>$</b> ssh -N -L 5432:127.0.0.1:5432 ai@ai-workspace</pre>
      </div>
    </section>

    <footer class="wrap pie">
      <p class="marca display" aria-hidden="true">ai-workspace</p>
      <p>v2 · Dusakawi EPS · Basado en docker-compose.yml, Dockerfile, entrypoint.sh y setup.sh</p>
    </footer>
  </main>
</Base>

<script>
  // Pestañas del ciclo de vida
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  tabs.forEach(b => b.addEventListener('click', () => {
    tabs.forEach(x => x.setAttribute('aria-selected', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => {
      p.hidden = p.dataset.panel !== b.dataset.tab;
      if (!p.hidden) p.querySelectorAll('li').forEach((li, i) =>
        li.animate?.([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], { duration: 400, delay: i * 40, easing: 'ease-out', fill: 'backwards' }));
    });
  }));

  // Copiar comandos
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach(b => b.addEventListener('click', async () => {
    const em = b.querySelector('em')!;
    try { await navigator.clipboard.writeText(b.dataset.copiar!); em.textContent = 'copiado ✓'; }
    catch { em.textContent = 'no se pudo'; }
    setTimeout(() => (em.textContent = 'copiar'), 1500);
  }));
</script>

<style>
  /* Fondo: rejilla + orbes de luz */
  .fondo { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .rejilla { position: absolute; inset: 0;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 56px 56px; mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 75%); }
  .orbe { position: absolute; border-radius: 50%; filter: blur(80px); }
  .o1 { width: 520px; height: 520px; top: -180px; left: 8%; background: var(--glow); animation: flotar 18s ease-in-out infinite; }
  .o2 { width: 460px; height: 460px; top: -120px; right: 4%; background: var(--glow-2); animation: flotar 22s ease-in-out infinite reverse; }
  @keyframes flotar { 50% { transform: translate(40px, 30px) scale(1.08); } }

  /* Hero */
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: center; padding-top: 9rem; padding-bottom: 3rem; }
  @media (max-width: 920px) { .hero { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 7.5rem; } }
  .pill { display: inline-flex; align-items: center; gap: .55rem; font-size: .8rem; color: var(--muted); text-decoration: none;
          border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 70%, transparent); padding: .32rem .8rem; border-radius: 99px; }
  .pill:hover { color: var(--fg); }
  .live { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 var(--accent); animation: latido 2s infinite; }
  @keyframes latido { 70% { box-shadow: 0 0 0 7px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  h1 { font-size: clamp(2.5rem, 6.4vw, 4.4rem); line-height: 1.02; letter-spacing: -.045em; font-weight: 700; margin: 1.3rem 0 1.2rem; }
  .grad { background: linear-gradient(100deg, var(--accent) 10%, var(--accent-2) 90%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { color: var(--muted); font-size: 1.07rem; max-width: 540px; margin: 0; }
  .lead strong { color: var(--fg); font-weight: 600; }
  .cta { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 2rem; }
  .btn { display: inline-flex; align-items: center; gap: .45rem; text-decoration: none; padding: .7rem 1.15rem; border-radius: 11px;
         font-weight: 500; font-size: .9rem; border: 1px solid var(--border); background: var(--surface); transition: transform .15s, border-color .15s; }
  .btn:hover { transform: translateY(-1px); border-color: var(--subtle); }
  .btn svg { width: 16px; height: 16px; }
  .primario { background: var(--fg); color: var(--bg); border-color: var(--fg); }

  /* Terminal */
  .term { border-radius: 16px; overflow: hidden; background: var(--term-bg); color: var(--term-fg); border: 1px solid #ffffff14;
          box-shadow: 0 30px 80px -20px rgb(0 0 0 / .45), 0 0 0 1px rgb(0 0 0 / .2); }
  .hero .term { transform: perspective(1400px) rotateY(-6deg) rotateX(2deg); transition: transform .6s; }
  .hero .term:hover { transform: none; }
  @media (max-width: 920px) { .hero .term { transform: none; } }
  .term-bar { display: flex; align-items: center; gap: 6px; padding: .7rem .9rem; border-bottom: 1px solid #ffffff10; background: #ffffff06; }
  .term-bar i { width: 10px; height: 10px; border-radius: 50%; background: #ffffff1f; }
  .term-bar i:first-child { background: #ff5f57; } .term-bar i:nth-child(2) { background: #febc2e; } .term-bar i:nth-child(3) { background: #28c840; }
  .term-bar span { margin-left: auto; margin-right: auto; font-size: .72rem; color: #8c9a92; transform: translateX(-18px); }
  pre { margin: 0; padding: 1.1rem 1.2rem 1.3rem; font-size: .78rem; line-height: 1.75; overflow-x: auto; white-space: pre; }
  pre b { color: #3ee6a4; font-weight: 500; }
  .ln { display: inline; opacity: 0; animation: aparecer .01s forwards; animation-delay: calc(var(--i) * 420ms + 300ms); }
  .ln.info { color: #9aa8a0; } .ln.ok { color: #3ee6a4; } .ln.dim, pre .dim { color: #7d8b84; }
  @keyframes aparecer { to { opacity: 1; } }
  .cursor { color: #3ee6a4; opacity: 0; animation: aparecer .01s forwards, parpadeo 1s steps(1) infinite;
            animation-delay: calc(var(--i) * 420ms + 300ms), calc(var(--i) * 420ms + 300ms); }
  @keyframes parpadeo { 50% { opacity: 0; } }
  .mini { margin-top: 1rem; }
  .entra { animation: subir .9s .15s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes subir { from { opacity: 0; translate: 0 24px; } }

  /* Stats */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--border); border-radius: 18px;
           background: color-mix(in srgb, var(--surface) 80%, transparent); backdrop-filter: blur(6px); padding: 0; overflow: hidden; }
  .stats div { padding: 1.4rem 1.5rem; border-right: 1px solid var(--border); display: grid; gap: .2rem; }
  .stats div:last-child { border-right: 0; }
  .stats strong { font-size: 2.6rem; line-height: 1; font-weight: 600; letter-spacing: -.04em;
                  background: linear-gradient(180deg, var(--fg), var(--muted)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats span { color: var(--muted); font-size: .84rem; }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr 1fr; } .stats div:nth-child(2) { border-right: 0; } .stats div:nth-child(-n+2) { border-bottom: 1px solid var(--border); } }
  .wrap.stats { max-width: 1048px; margin: 0 auto; }
  @media (max-width: 1080px) { .wrap.stats { margin: 0 16px; } }

  /* Encabezados de sección */
  .bloque { margin-top: 7rem; }
  .cab { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; margin-bottom: 2rem; max-width: 760px; }
  .num { grid-row: span 2; color: var(--accent); font-size: .8rem; padding-top: .55rem; }
  .cab h2 { margin: 0; font-size: clamp(1.6rem, 3.6vw, 2.3rem); letter-spacing: -.035em; line-height: 1.1; }
  .cab p { margin: .6rem 0 0; color: var(--muted); }
  h3 { margin: 0; font-size: 1rem; letter-spacing: -.01em; font-weight: 600; }
  p { margin: 0; }
  .nota { color: var(--muted); font-size: .9rem; margin-top: 1.25rem; max-width: 720px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow); }

  /* Tabs + pasos */
