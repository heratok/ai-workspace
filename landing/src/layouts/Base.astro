---
interface Props { title: string }
const { title } = Astro.props;
const secciones = [['#diagrama', 'Diagrama'], ['#ciclo', 'Ciclo de vida'], ['#imagen', 'Imagen'], ['#seguridad', 'Seguridad'], ['#operacion', 'Operación']];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <!-- Tema y clase js antes de pintar para evitar parpadeo -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try { const t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <style is:global>
      :root {
        --bg: #f6f7f4; --surface: #ffffff; --surface-2: #fbfcfa; --fg: #0b0d0c; --muted: #5c645f; --subtle: #9aa19c;
        --border: #e2e5e1; --hover: #eef1ed; --accent: #08936a; --accent-2: #5b4ce0; --accent-soft: #e3f5ee;
        --warn: #a86b12; --warn-soft: #fbf1df; --danger: #cc3b3b; --danger-soft: #fcebeb;
        --grid: rgb(0 0 0 / .045); --glow: rgb(8 147 106 / .16); --glow-2: rgb(91 76 224 / .12);
        --shadow: 0 1px 2px rgb(0 0 0 / .04), 0 8px 24px rgb(0 0 0 / .05);
        --term-bg: #0d1110; --term-fg: #d9e3dd;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #060807; --surface: #0d1110; --surface-2: #0a0d0c; --fg: #eef3f0; --muted: #98a29c; --subtle: #5b6560;
          --border: #1b2220; --hover: #131917; --accent: #3ee6a4; --accent-2: #9d8fff; --accent-soft: #0e2a20;
          --warn: #f0b84a; --warn-soft: #2a2112; --danger: #f87171; --danger-soft: #2a1414;
          --grid: rgb(255 255 255 / .035); --glow: rgb(62 230 164 / .14); --glow-2: rgb(157 143 255 / .12);
          --shadow: none; --term-bg: #090c0b; --term-fg: #d9e3dd;
          color-scheme: dark;
        }
      }
      :root[data-theme="dark"] {
        --bg: #060807; --surface: #0d1110; --surface-2: #0a0d0c; --fg: #eef3f0; --muted: #98a29c; --subtle: #5b6560;
        --border: #1b2220; --hover: #131917; --accent: #3ee6a4; --accent-2: #9d8fff; --accent-soft: #0e2a20;
        --warn: #f0b84a; --warn-soft: #2a2112; --danger: #f87171; --danger-soft: #2a1414;
        --grid: rgb(255 255 255 / .035); --glow: rgb(62 230 164 / .14); --glow-2: rgb(157 143 255 / .12);
        --shadow: none; --term-bg: #090c0b; --term-fg: #d9e3dd;
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html { -webkit-font-smoothing: antialiased; scroll-behavior: smooth; scroll-padding-top: 88px; }
      body {
        margin: 0; min-height: 100vh; background: var(--bg); color: var(--fg); overflow-x: hidden;
        font: 15px/1.6 Inter, system-ui, -apple-system, sans-serif;
      }
      a { color: inherit; }
      h1, h2, h3, .display { font-family: 'Space Grotesk', Inter, sans-serif; }
      code, .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .85em; }
      code { background: var(--hover); border: 1px solid var(--border); padding: .05rem .35rem; border-radius: 5px; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
      ::selection { background: var(--accent); color: var(--bg); }

      /* Barra de progreso + nav flotante */
      #progreso { position: fixed; inset: 0 0 auto 0; height: 2px; z-index: 30; transform-origin: 0 50%; transform: scaleX(0);
                  background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
      .nav { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 20; width: min(1048px, calc(100% - 24px));
             display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: .4rem .45rem .4rem .9rem;
             border: 1px solid var(--border); border-radius: 14px; backdrop-filter: blur(14px) saturate(1.4);
             background: color-mix(in srgb, var(--surface) 72%, transparent); }
      .brand { display: flex; align-items: center; gap: .55rem; font: 600 .95rem 'Space Grotesk', sans-serif; text-decoration: none; }
      .logo { width: 22px; height: 22px; }
      .links { display: flex; align-items: center; gap: .1rem; }
      .links a { text-decoration: none; color: var(--muted); padding: .38rem .7rem; border-radius: 9px; font-size: .86rem; transition: color .15s, background .15s; }
      .links a:hover, .links a.activo { color: var(--fg); background: var(--hover); }
      #tema { display: grid; place-items: center; width: 34px; height: 34px; margin-left: .2rem; cursor: pointer;
              border: 1px solid var(--border); background: var(--surface); color: var(--fg); border-radius: 9px; }
      #tema:hover { background: var(--hover); }
      #tema svg { width: 16px; height: 16px; }
      .sol { display: none; }
      :root[data-theme="dark"] .sol { display: block; } :root[data-theme="dark"] .luna { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .sol { display: block; } :root:not([data-theme="light"]) .luna { display: none; }
      }
      @media (max-width: 760px) { .links a { display: none; } }

      /* Aparición al hacer scroll (solo con JS; sin JS todo es visible) */
      .js .rv { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
      .js .rv.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .js .rv { opacity: 1; transform: none; transition: none; }
        *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; }
      }
    </style>
  </head>
  <body>
    <div id="progreso" aria-hidden="true"></div>
    <header class="nav">
      <a class="brand" href="#top">
        <svg class="logo" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="6" stroke="var(--accent)" stroke-width="1.6"/><path d="M8 9l3 3-3 3M13 15h3.5" stroke="var(--fg)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        ai-workspace
      </a>
      <nav class="links">
        {secciones.map(([h, t]) => <a href={h}>{t}</a>)}
        <button id="tema" aria-label="Cambiar tema" title="Cambiar tema">
          <svg class="luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </nav>
    </header>
    <slot />
    <script>
      const root = document.documentElement;
      document.getElementById('tema')!.addEventListener('click', () => {
        const actual = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const nuevo = actual === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nuevo;
        try { localStorage.setItem('tema', nuevo); } catch {}
      });

      // Progreso de lectura
      const barra = document.getElementById('progreso')!;
      const pintar = () => {
        const max = root.scrollHeight - innerHeight;
        barra.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
      };
      addEventListener('scroll', pintar, { passive: true }); pintar();

      // Aparición + sección activa en el nav
      const io = new IntersectionObserver(es => es.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.rv').forEach(el => io.observe(el));

      const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('.links a')];
      const spy = new IntersectionObserver(es => es.forEach(e => {
        if (!e.isIntersecting) return;
        enlaces.forEach(a => a.classList.toggle('activo', a.hash === `#${e.target.id}`));
      }), { rootMargin: '-45% 0px -50% 0px' });
      enlaces.forEach(a => { const s = document.querySelector(a.hash); if (s) spy.observe(s); });
    </script>
  </body>
</html>
