---
// Diagrama interactivo: cada nodo es un botón que muestra su detalle en el panel.
const nodos = {
  pc: { t: 'Tu PC', s: 'cliente en la tailnet', d: 'Conectado a la misma tailnet. Entra por SSH o mosh a ai-workspace (MagicDNS) o a la IP 100.x. Los dev servers se abren en :3000 y :5173.', tag: 'origen' },
  internet: { t: 'Internet público', s: 'sin camino de entrada', d: 'El compose no declara ports:, así que Docker no abre nada en el servidor. No hay puerto que escanear: el único tráfico que entra es WireGuard cifrado hacia el sidecar.', tag: 'bloqueado' },
  ts: { t: 'ai-workspace-ts', s: 'sidecar Tailscale', d: 'La única puerta. Es el único contenedor con NET_ADMIN y /dev/net/tun; modo kernel (TCP y UDP completos para mosh). Tiene healthcheck en 127.0.0.1:9002 y su identidad persiste en ai_ts_state.', tag: 'red' },
  ws: { t: 'ai-workspace', s: 'entorno de desarrollo', d: 'Debian 12 con usuario ai sin root. Usa network_mode: service:tailscale: comparte la red del sidecar, así que no tiene puertos ni hostname propios. sshd en :22, mosh en 60000-60010/udp y bases locales con devdb.', tag: 'app' },
  mssql: { t: 'ai-workspace-mssql', s: 'SQL Server opcional', d: 'Solo con COMPOSE_PROFILES=mssql. Va aparte porque SQL Server no corre sin root. El workspace lo ve como mssql:1433 por la red de compose; no llega a la tailnet.', tag: 'opcional' },
  vol: { t: 'Volúmenes', s: 'lo que persiste', d: 'ai_home (config y bases devdb), ai_workspace (proyectos), ai_ssh_host_keys (identidad SSH), ai_ts_state (nodo Tailscale). Sobreviven a update y a uninstall.', tag: 'datos' },
};
---
<div class="diag rv">
  <div class="lienzo">
    <svg viewBox="0 0 760 450" role="group" aria-label="Arquitectura: tu PC entra por Tailscale al sidecar, que comparte red con el workspace">
      <defs>
        <marker id="fl" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10z" class="punta"/></marker>
        <filter id="brillo" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>
        <linearGradient id="gws" x1="0" x2="1"><stop offset="0" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--accent-2)"/></linearGradient>
      </defs>

      <!-- Rutas de tráfico -->
      <path id="r1" d="M160 127 H282" class="flujo" marker-end="url(#fl)"/>
      <path id="r2" d="M456 168 H476" class="flujo" marker-end="url(#fl)"/>
      <path d="M160 332 H246" class="corte"/>
      <text x="205" y="117" class="s ac">WireGuard</text>
      <path d="M597 272 V300" class="linea"/>

      <circle r="4" class="pkt halo"><animateMotion dur="2.2s" repeatCount="indefinite" path="M160 127 H282"/></circle>
      <circle r="3" class="pkt"><animateMotion dur="2.2s" repeatCount="indefinite" path="M160 127 H282"/></circle>
      <circle r="3" class="pkt"><animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite" path="M160 127 H282"/></circle>
      <circle r="3" class="pkt"><animateMotion dur="1s" repeatCount="indefinite" path="M456 168 H478"/></circle>
      <circle r="3" class="pkt mal"><animateMotion dur="2s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;.6;1" calcMode="linear" path="M160 332 H236"/></circle>

      <g class="nd" data-k="pc" tabindex="0" role="button" aria-label="Tu PC">
        <rect x="10" y="90" width="150" height="74" rx="12" class="nodo"/>
        <text x="85" y="122" class="t">Tu PC</text>
        <text x="85" y="142" class="s">en la tailnet</text>
      </g>

      <g class="nd" data-k="internet" tabindex="0" role="button" aria-label="Internet público">
        <rect x="10" y="300" width="150" height="64" rx="12" class="nodo bloq"/>
        <text x="85" y="328" class="t dn">Internet público</text>
        <text x="85" y="347" class="s">sin puertos abiertos</text>
      </g>
      <text x="240" y="337" class="s dn x">✕</text>

      <rect x="250" y="10" width="500" height="430" rx="16" class="caja"/>
      <text x="270" y="34" class="et">SERVIDOR LINUX · SOLO DOCKER</text>
      <rect x="268" y="48" width="464" height="240" rx="13" class="caja ns"/>
      <text x="286" y="70" class="et">RED COMPARTIDA · network_mode: service:tailscale</text>

      <g class="nd" data-k="ts" tabindex="0" role="button" aria-label="Sidecar Tailscale">
        <rect x="286" y="86" width="170" height="186" rx="12" class="nodo"/>
        <text x="371" y="114" class="t">Tailscale</text>
        <text x="371" y="132" class="s">ai-workspace-ts · sidecar</text>
        <text x="371" y="164" class="s m">cap NET_ADMIN</text>
        <text x="371" y="182" class="s m">/dev/net/tun</text>
        <text x="371" y="200" class="s m">healthz :9002</text>
        <text x="371" y="236" class="s">tailscale0 · IP 100.x</text>
        <text x="371" y="254" class="s">MagicDNS: ai-workspace</text>
      </g>

      <g class="nd" data-k="ws" tabindex="0" role="button" aria-label="Workspace">
        <rect x="480" y="86" width="234" height="186" rx="12" class="nodo ws"/>
        <text x="597" y="114" class="t">ai-workspace</text>
        <text x="597" y="132" class="s">Debian 12 · usuario ai · sin root</text>
        <rect x="498" y="146" width="198" height="40" rx="8" class="app"/>
        <text x="597" y="164" class="t ac">sshd :22 · mosh udp</text>
        <text x="597" y="179" class="s">solo clave pública</text>
        <rect x="498" y="194" width="198" height="30" rx="8" class="inner"/>
        <text x="597" y="213" class="s m">dev servers :3000 · :5173</text>
        <rect x="498" y="232" width="198" height="30" rx="8" class="inner"/>
        <text x="597" y="251" class="s m">devdb → Postgres · Redis</text>
      </g>

      <g class="nd" data-k="mssql" tabindex="0" role="button" aria-label="SQL Server opcional">
        <rect x="480" y="300" width="234" height="44" rx="10" class="nodo opc"/>
        <text x="597" y="319" class="t">mssql :1433</text>
        <text x="597" y="335" class="s">opcional · COMPOSE_PROFILES=mssql</text>
      </g>

      <g class="nd" data-k="vol" tabindex="0" role="button" aria-label="Volúmenes">
        <text x="286" y="374" class="et">VOLÚMENES · sobreviven a update y uninstall</text>
        <rect x="268" y="384" width="108" height="40" rx="9" class="vol"/>
        <text x="322" y="408" class="s m">ai_ts_state</text>
        <rect x="387" y="384" width="108" height="40" rx="9" class="vol"/>
        <text x="441" y="408" class="s m">ai_home</text>
        <rect x="505" y="384" width="108" height="40" rx="9" class="vol"/>
        <text x="559" y="408" class="s m">ai_workspace</text>
        <rect x="624" y="384" width="108" height="40" rx="9" class="vol"/>
        <text x="678" y="408" class="s m">ssh_host_keys</text>
      </g>
    </svg>
    <p class="desliza">Desliza para ver todo →</p>
  </div>

  <aside class="panel" aria-live="polite">
    <p class="pista">Toca un bloque del diagrama</p>
    <div class="chips" role="tablist">
      {Object.entries(nodos).map(([k, n]) => <button class="chip" data-k={k} role="tab">{n.t}</button>)}
    </div>
    <div class="detalle">
      <span class="tag mono" data-campo="tag">{nodos.ts.tag}</span>
      <h3 data-campo="t">{nodos.ts.t}</h3>
      <p class="sub" data-campo="s">{nodos.ts.s}</p>
      <p data-campo="d">{nodos.ts.d}</p>
    </div>
  </aside>
</div>

<script define:vars={{ nodos }}>
  const diag = document.querySelector('.diag');
  const campos = diag.querySelectorAll('[data-campo]');
  const elegir = k => {
    const n = nodos[k];
    campos.forEach(c => { c.textContent = n[c.dataset.campo]; });
    diag.querySelectorAll('[data-k]').forEach(el => {
      const on = el.dataset.k === k;
      el.classList.toggle('on', on);
      if (el.matches('.chip')) el.setAttribute('aria-selected', String(on));
    });
    diag.querySelector('.detalle').animate?.([{ opacity: .3, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
  };
  diag.querySelectorAll('[data-k]').forEach(el => {
    el.addEventListener('click', () => elegir(el.dataset.k));
    el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); elegir(el.dataset.k); } });
  });
  elegir('ts');
</script>

<style>
  .diag { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 1rem; }
  @media (max-width: 900px) { .diag { grid-template-columns: 1fr; } }
  .lienzo { border: 1px solid var(--border); border-radius: 18px; padding: 1rem; overflow-x: auto;
            background: radial-gradient(600px 300px at 70% 30%, var(--glow), transparent 70%), var(--surface); }
  .desliza { display: none; margin: .6rem 0 0; font-size: .75rem; color: var(--subtle); position: sticky; left: 0; }
  @media (max-width: 700px) { .desliza { display: block; } }
  svg { display: block; width: 100%; min-width: 620px; height: auto; font-family: Inter, system-ui, sans-serif; }
  .caja { fill: none; stroke: var(--border); stroke-width: 1.2; }
  .ns { stroke-dasharray: 4 4; stroke: var(--subtle); }
  .nodo { fill: var(--surface-2); stroke: var(--border); stroke-width: 1.2; transition: stroke .2s, fill .2s; }
  .inner { fill: none; stroke: var(--border); }
  .opc { stroke-dasharray: 4 4; stroke: var(--subtle); }
  .bloq { stroke: var(--danger); stroke-dasharray: 4 4; }
  .app { fill: var(--accent-soft); stroke: var(--accent); }
  .vol { fill: var(--hover); stroke: var(--border); transition: stroke .2s; }
  .t { fill: var(--fg); font-size: 13px; font-weight: 600; text-anchor: middle; }
  .s { fill: var(--muted); font-size: 11px; text-anchor: middle; }
  .m { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; }
  .et { fill: var(--subtle); font-size: 10px; letter-spacing: .08em; font-weight: 500; }
  .ac { fill: var(--accent); } .dn { fill: var(--danger); }
  .x { font-size: 14px; font-weight: 600; }
  .punta { fill: var(--accent); }
  .linea { stroke: var(--subtle); stroke-width: 1.2; stroke-dasharray: 3 3; fill: none; }
  .flujo { stroke: var(--accent); stroke-width: 1.4; fill: none; stroke-dasharray: 5 4; opacity: .7; }
  .corte { stroke: var(--danger); stroke-width: 1.2; fill: none; stroke-dasharray: 3 4; opacity: .6; }
  .pkt { fill: var(--accent); }
  .pkt.halo { fill: var(--accent); filter: url(#brillo); opacity: .8; }
  .pkt.mal { fill: var(--danger); }
  @media (prefers-reduced-motion: reduce) { .pkt { display: none; } }

  .nd { cursor: pointer; outline: none; }
  .nd:hover .nodo, .nd:focus-visible .nodo, .nd.on .nodo { stroke: var(--accent); stroke-width: 1.8; }
  .nd.on .ws, .nd:hover .ws { stroke: url(#gws); }
  .nd.on .bloq, .nd:hover .bloq { stroke: var(--danger); }
  .nd:hover .vol, .nd.on .vol, .nd:focus-visible .vol { stroke: var(--accent); }

  .panel { border: 1px solid var(--border); border-radius: 18px; padding: 1.25rem; background: var(--surface); display: flex; flex-direction: column; gap: 1rem; }
  .pista { margin: 0; font-size: .78rem; color: var(--subtle); text-transform: uppercase; letter-spacing: .08em; }
  .chips { display: flex; flex-wrap: wrap; gap: .35rem; }
  .chip { font: 500 .78rem Inter, sans-serif; padding: .3rem .65rem; border-radius: 99px; border: 1px solid var(--border);
          background: transparent; color: var(--muted); cursor: pointer; transition: all .15s; }
  .chip:hover { color: var(--fg); border-color: var(--subtle); }
  .chip.on { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .detalle { border-top: 1px solid var(--border); padding-top: 1rem; }
  .tag { display: inline-block; font-size: .7rem; color: var(--accent); background: var(--accent-soft); padding: .1rem .5rem; border-radius: 6px; text-transform: uppercase; letter-spacing: .06em; }
  .detalle h3 { margin: .6rem 0 0; font-size: 1.2rem; letter-spacing: -.01em; }
  .sub { margin: .1rem 0 .7rem; color: var(--subtle); font-size: .85rem; }
  .detalle p:last-child { margin: 0; color: var(--muted); font-size: .9rem; }
</style>
