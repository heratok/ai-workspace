# =============================================================================
# Plantilla del archivo .env de ai-workspace
# setup.sh crea/actualiza .env automáticamente (permisos 600). Si prefieres
# hacerlo a mano:  cp env.example .env && chmod 600 .env
# NUNCA subas .env a git.
# =============================================================================

# --- Instancia ---------------------------------------------------------------
# Vacío = instancia principal (contenedores ai-workspace*, volúmenes ai_*).
# Con alias "foo": todo se llama ai-workspace-foo (contenedores, volúmenes, imagen,
# nombre en Tailscale). Lo escribe setup.sh con "install --alias foo" (o install.sh);
# NO lo cambies después de instalar: apuntaría a otros volúmenes. setup.sh también
# guarda aquí AIWS_NAME y AIWS_VOL_PREFIX, derivados del alias.
AIWS_INSTANCE=

# --- Tailscale ---------------------------------------------------------------
# OPCIONAL: déjala vacía y setup.sh te la pedirá (solo pegar) o te dará un link
# de inicio de sesión. Si quieres dejarla aquí, créala en:
#   https://login.tailscale.com/admin/settings/keys  -> "Generate auth key"
#   - Reusable: sí        - Ephemeral: NO        - Tags: tag:ai-workspace (recomendado)
# setup.sh la borra de este archivo cuando el nodo queda registrado.
TS_AUTHKEY=

# Nombre del equipo en la tailnet (ssh ai@<este-nombre> con MagicDNS).
# En una instancia con alias, setup.sh lo cambia a ai-workspace-<alias> si no lo personalizaste.
TS_HOSTNAME=ai-workspace

# Argumentos extra para "tailscale up". Ej: --advertise-tags=tag:ai-workspace
TS_EXTRA_ARGS=

# Versión de la imagen de Tailscale (fija por defecto; "stable" para flotar)
# TS_IMAGE_TAG=v1.104.1

# --- Red ---------------------------------------------------------------------
# DNS para salir a internet desde el contenedor
DNS_SERVER=1.1.1.1

# --- Bases de datos -----------------------------------------------------------
# PostgreSQL y Redis NO vienen instalados. Dentro del workspace, sin root:
#   devdb install postgres 17 pgvector   |   devdb install redis   |   devdb start
# PG_MAJOR = versión del cliente psql en la imagen.
# INSTALL_PG_SERVER=true solo si prefieres el servidor ya horneado en la imagen.
PG_MAJOR=17
INSTALL_PG_SERVER=false
# Extensiones: paquetes postgresql-<PG_MAJOR>-<ext>. Ej: "pgvector postgis-3"
PG_EXTENSIONS=pgvector

# Servicios en contenedor aparte (opcional). Único disponible: mssql
#   COMPOSE_PROFILES=mssql
COMPOSE_PROFILES=

# SQL Server (perfil mssql). Vacía = se genera automáticamente.
MSSQL_SA_PASSWORD=
# "true" agrega sqlcmd/bcp (mssql-tools18) a la imagen -> requiere update
INSTALL_MSSQL_TOOLS=false

# Zona horaria de los servicios
TZ=America/Bogota

# --- Usuario y recursos ------------------------------------------------------
# Deben coincidir con el dueño actual del volumen ai_home (1000 por defecto)
USER_UID=1000
USER_GID=1000
# "true" UNA sola vez si cambiaste USER_UID/GID (chown recursivo de home y workspace)
FIX_OWNERSHIP=false
# Son TOPES por instancia, no reservas. Con varias instancias, sus topes se suman: aiws ls compara la suma con la RAM del servidor.
# En una instalación nueva setup.sh sugiere MEM_LIMIT y CPUS según la RAM, las CPUs y las instancias existentes (o usa --mem y --cpus).
MEM_LIMIT=8g
CPUS=4
# Memoria compartida (/dev/shm; Chromium necesita bastante) y máximo de procesos del workspace
SHM_SIZE=2gb
PIDS_LIMIT=2048
# Tope de memoria de SQL Server (perfil mssql)
MSSQL_MEM_LIMIT=4g
# Estos topes se cambian SIN reconstruir:  ./setup.sh resources --mem 4g --cpus 2   (o aiws resources ALIAS ...)

# --- Imagen ------------------------------------------------------------------
NODE_MAJOR=24
# VERSIONES FIJADAS (builds reproducibles). Van COMENTADAS a propósito: el valor por defecto sale del Dockerfile y de
# docker-compose.yml, y setup.sh copia este archivo a tu .env (si estuvieran activas, tu servidor quedaría congelado y
# no recibiría los cambios del repo en "upgrade"). Para fijar OTRA versión SOLO en este servidor: ./setup.sh tools
# (lista las nuevas y las guarda aquí en el .env) o descomenta una línea. "./setup.sh tools --reset" las quita.
# En el repo se cambian con scripts/update-pins.sh (y un PR). Aplica los cambios con ./setup.sh update.
# "latest" en una línea de npm = la última al construir (no reproducible).
# CLAUDE_CODE_VERSION=2.1.296
# PI_VERSION=0.73.1
# OPENCODE_VERSION=1.19.0
# PLAYWRIGHT_VERSION=1.64.0
# PLAYWRIGHT_CLI_VERSION=0.1.22
# PLAYWRIGHT_MCP_VERSION=0.0.83
# UV_VERSION=0.13.0
# MISE_VERSION=v2026.10.8
# Herdr y Gentle AI: binario de esa release verificado con su checksum. Si cambias HERDR_VERSION, cambia también sus
# SHA256 (usa scripts/update-pins.sh: list / choose / set / latest; los calcula solo).
# HERDR_VERSION=0.9.4
# HERDR_SHA256_AMD64=493304fbefb0ed0ea0455f373b47f48d24e8774bc7974f4c916ad2e937675b23
# HERDR_SHA256_ARM64=9511cb70982c1ef115f232058e7ed7cf9640aa5a2c0ca78934cefda3aeb093fd
# GENTLE_AI_VERSION=4.1.1
# Doppler: release de GitHub verificada con su checksums.txt (antes se instalaba del repo apt sin versión).
# DOPPLER_VERSION=3.77.0
# agy NO se fija a propósito: siempre instala la última al construir (Google no lista versiones ni da URLs predecibles).
# Vacío = última versión del major. Fíjala para builds reproducibles (ej. 24.11.1)
NODE_VERSION=
# --- Componentes de la imagen ---------------------------------------------------
# Elígelos con un menú:  ./setup.sh components   (luego se reconstruye)
INSTALL_CLAUDE=true
INSTALL_PI=true
INSTALL_OPENCODE=false
INSTALL_PLAYWRIGHT=true
INSTALL_GENTLE_AI=true
INSTALL_AGY=true
# CLIs npm adicionales para todo el equipo (ej: @openai/codex)
NPM_EXTRA_PACKAGES=
INSTALL_PLAYWRIGHT_BROWSERS=true

# Herdr (https://herdr.dev) incluido en la imagen
INSTALL_HERDR=true

# --- Doppler (secretos) --------------------------------------------------------
# CLI incluida en la imagen. Dos formas de autenticarse:
#   a) Dentro del workspace: doppler login  (una vez; queda en ~/.doppler)
#   b) Token de servicio aquí (dp.st.xxx): solo lectura de un proyecto/config
INSTALL_DOPPLER=true
DOPPLER_TOKEN=
