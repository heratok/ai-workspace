#!/usr/bin/env bash
# Diagnóstico rápido del entorno: versiones, rutas y escritura sin root.
set -uo pipefail

ok()   { printf '  \e[32m✔\e[0m %-14s %s\n' "$1" "$2"; }
fail() { printf '  \e[31m✘\e[0m %-14s %s\n' "$1" "$2"; FAILED=1; }
FAILED=0

check() {
  local name="$1"; shift
  if out="$("$@" 2>/dev/null | head -n1)"; then ok "$name" "$out ($(command -v "$1"))"; else fail "$name" "no disponible"; fi
}

echo "Herramientas:"
check node    node --version
check npm     npm --version
check claude  claude --version
check pi      pi --version
if command -v herdr >/dev/null; then ok herdr "$(command -v herdr)"; else echo "  - herdr          no incluido (INSTALL_HERDR=false)"; fi
if command -v doppler >/dev/null; then check doppler doppler --version; fi
if command -v opencode >/dev/null; then check opencode opencode --version; fi
check pw      playwright --version
check pw-cli  playwright-cli --version
check pw-mcp  playwright-mcp --version
check uv      uv --version
check mise    mise --version
check python3 python3 --version
check git     git --version
check gh      gh --version
check psql    psql --version
check sqlite3 sqlite3 --version
check redis   redis-cli --version
check devdb   devdb help
if command -v sqlcmd >/dev/null; then check sqlcmd sqlcmd -?; fi
check rg      rg --version
check fd      fd --version

echo "Bases de datos locales (devdb):"
devdb installed 2>/dev/null | sed 's/^/    /'
devdb status 2>/dev/null | sed -n '1,2p' | sed 's/^/    /'
if [[ -n "${SQLCMDSERVER:-}" ]] && getent hosts "$SQLCMDSERVER" >/dev/null; then
  ok mssql "$SQLCMDSERVER (sqlcmd -C -Q 'SELECT @@VERSION')"
fi

echo "Playwright:"
if ls -d "${PLAYWRIGHT_BROWSERS_PATH:-/opt/ms-playwright}"/chromium* >/dev/null 2>&1; then
  ok chromium "$(ls -d "${PLAYWRIGHT_BROWSERS_PATH}"/chromium* | xargs -n1 basename | tr '\n' ' ')"
else
  fail chromium "no encontrado en ${PLAYWRIGHT_BROWSERS_PATH:-/opt/ms-playwright}"
fi

echo "Escritura sin root:"
for d in "$HOME" /workspace "${NPM_CONFIG_PREFIX:-$HOME/.npm-global}" "$HOME/.local/bin"; do
  mkdir -p "$d" 2>/dev/null
  if [[ -w "$d" ]]; then ok "$(basename "$d")" "$d"; else fail "$(basename "$d")" "$d no escribible"; fi
done

echo "Entorno:"
ok LANG "${LANG:-<vacío>}"
ok PATH "$PATH"

exit "$FAILED"
