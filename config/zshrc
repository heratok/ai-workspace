# Config zsh de sistema (interactiva). Se carga desde /etc/zsh/zshrc.
# Personalizaciones del usuario: ~/.zshrc o ~/.zshrc.local (persisten en el volumen).

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE AUTO_CD INTERACTIVE_COMMENTS

autoload -Uz compinit && compinit -d "$HOME/.zcompdump"
zstyle ':completion:*' menu select

# fzf (Debian 12)
[[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[[ -r /usr/share/doc/fzf/examples/completion.zsh ]]   && source /usr/share/doc/fzf/examples/completion.zsh

# mise: activa versiones por proyecto (.mise.toml / .tool-versions)
command -v mise >/dev/null && eval "$(mise activate zsh)"

alias ll='ls -lah --color=auto'
alias cat='bat --paging=never --style=plain'

PROMPT='%F{cyan}%n@%m%f %F{yellow}%~%f %# '

# Plugins (siempre al final; syntax-highlighting el último)
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
